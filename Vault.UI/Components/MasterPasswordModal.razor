@using System.Security.Cryptography
@using System.Text
@using Vault.Core.Abstractions
@using Vault.UI.Services

@if (!AppState.IsUnlocked)
{
    <div class="master-password-overlay" aria-modal="true" role="dialog">
        <section class="master-password-dialog">
            <p class="master-password-kicker">Vault Access</p>
            <h1>PassCrypt</h1>
            <p class="master-password-subtitle">Enter your master password to unlock your vault.</p>

            @if (_isFirstRun)
            {
                <p class="master-password-warning">
                    First-time setup: This password becomes your
                    master password and cannot be changed or recovered.
                </p>
            }
            else
            {
                <p class="master-password-hint">
                    Your vault stays encrypted until this password is verified.
                </p>
            }

            <EditForm Model="this" OnValidSubmit="HandleUnlockAsync">
                <div class="master-password-field">
                    <label for="master-password">Master password</label>
                    <input id="master-password"
                           type="password"
                           @bind="_password"
                           @bind:event="oninput"
                           autocomplete="current-password"
                           disabled="@_isUnlocking" />
                </div>

                @if (_error is not null)
                {
                    <p class="master-password-error" role="alert">@_error</p>
                }

                <footer class="master-password-footer">
                    <span class="master-password-footer-note">Encrypted locally</span>
                    <button type="submit" class="master-password-submit" disabled="@_isUnlocking">
                        @(_isUnlocking ? "Unlocking..." : "Unlock")
                    </button>
                </footer>
            </EditForm>
        </section>
    </div>
}

@code {
    [Inject]
    private IVaultSessionService VaultSession { get; set; } = default!;

    [Inject]
    private VaultAppState AppState { get; set; } = default!;

    [Inject] 
    private IVaultFileStore VaultFileStore { get; set; } = default!;
    
    // For navigating pages
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;
    
    private bool _isFirstRun;
    private string _password = string.Empty;
    private string? _error;
    private bool _isUnlocking;

    
    @* Method for checking if vault file exists. Uses the already existing method from the vault session service. *@
    protected override void OnInitialized()
    {
        _isFirstRun = !VaultFileStore.Exists();
    }

    private async Task HandleUnlockAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_password))
        {
            _error = "Master password is required.";
            return;
        }

        _isUnlocking = true;

        try
        {
            byte[] passwordBytes = Encoding.UTF8.GetBytes(_password);
            _password = string.Empty;

            await VaultSession.UnlockWithPasswordAsync(passwordBytes);
            AppState.SetUnlocked();
            // Navigate to dashboard upon successful unlock
            Navigation.NavigateTo("/dashboard");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (CryptographicException)
        {
            _error = "Incorrect master password.";
        }
        catch (Exception)
        {
            _error = "Could not unlock. Try again.";
        }
        finally
        { 
            _isUnlocking = false;
        }
    }
}


