@page "/dashboard"
@using Vault.Core
@using Vault.Facade.Interface
@inject IVaultFacade VaultFacade
@inject VaultAppState AppState

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-container">
    <section class="dashboard-card">
        <p class="dashboard-kicker">Vault Overview</p>
        <h1 class="dashboard-title">PassCrypt</h1>

        <div class="dashboard-metrics">
            <article class="metric-card">
                <span class="metric-value">@EntryCount</span>
                <span class="metric-label">Saved Entries</span>
            </article>
            <article class="metric-card">
                <span class="metric-value">@StrongPasswordCount</span>
                <span class="metric-label">Strong Passwords</span>
            </article>
            <article class="metric-card">
                <span class="metric-value">@DistinctCategories</span>
                <span class="metric-label">Categories</span>
            </article>
        </div>

        <div class="dashboard-actions">
            <button class="btn" @onclick="OpenAddEntry">Add Entry</button>
            <button class="btn" @onclick="OpenViewEntry">View Entries</button>
        </div>
    </section>
</div>


@if (showViewEntryModal)
{
    <div class="modal-overlay" @onclick="CloseViewEntry">
        <section class="modal-panel modal-panel-wide" aria-labelledby="view-entries-title" aria-modal="true" role="dialog" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="CloseViewEntry">×</button>
            <header class="modal-header">
                <h2 id="view-entries-title" class="modal-title">View Entries</h2>
                <p class="modal-subtitle">Browse saved accounts and inspect details quickly.</p>
            </header>

            <div class="view-toolbar">
                <input class="field-input search-input" type="search" placeholder="Search by app, username, or tag..." />
                <button class="panel-btn" type="button">Newest</button>
                <button class="panel-btn" type="button">A-Å</button>
            </div>

            @* Entries panel *@ 
            <div class="entries-layout">
                <aside class="entries-list">
                    @if (_entries.Count == 0)
                    {
                        <div class="empty-state">No saved entries yet.</div>
                    }
                    else
                    {
                        @foreach (var entry in _entries)
                        {
                            <article class="entry-item @(ReferenceEquals(_selectedEntry, entry) ? "is-selected" : "")"
                                     role="button"
                                     tabindex="0"
                                     @onclick="() => SelectEntry(entry)">
                                <strong>@entry.EntryName</strong>
                                <div>@entry.Username</div>
                            </article>
                        }
                    }
                </aside>

                @if (_selectedEntry is null)
                {
                    <div class="empty-state">Select an entry to view its details.</div>
                }
                else if (_isEditingEntry)
                {
                    /* Converts text fields to writeable fields upon _isEditingEntry */
                    <section class="entry-details">
                        <label class="form-field">
                            <span>Entry name</span>
                            <input class="field-input" type="text" @bind="_editEntryName" />
                        </label>

                        <label class="form-field">
                            <span>Category</span>
                            <input class="field-input" type="text" @bind="_editCategory" />
                        </label>

                        <label class="form-field">
                            <span>URL</span>
                            <input class="field-input" type="url" @bind="_editUrl" />
                        </label>

                        <label class="form-field">
                            <span>Username</span>
                            <input class="field-input" type="text" @bind="_editUsername" />
                        </label>

                        <label class="form-field">
                            <span>Password</span>
                            <input class="field-input" type="text" @bind="_editPassword" />
                        </label>

                        <label class="form-field">
                            <span>Tags (comma separated)</span>
                            <input class="field-input" type="text" @bind="_editTags" />
                        </label>

                        <label class="form-field form-field-full">
                            <span>Notes</span>
                            <textarea class="field-input notes-input" rows="5" @bind="_editNotes"></textarea>
                        </label>
                    </section>
                }
                else
                {
                    <section class="entry-details">
                        <h3>@_selectedEntry.EntryName</h3>
                        <p><strong>Username:</strong> @_selectedEntry.Username</p>
                        <p><strong>URL:</strong> @_selectedEntry.Url</p>
                        <p><strong>Category:</strong> @_selectedEntry.Category</p>
                        <p><strong>Notes:</strong> @_selectedEntry.Notes</p>
                        <p><strong>Tags:</strong> @string.Join(", ", _selectedEntry.Tags)</p>
                    </section>
                }
            </div>

            <footer class="modal-footer">
                <button class="panel-btn panel-btn-secondary" type="button">Copy Username</button>
                <button class="panel-btn panel-btn-secondary" type="button">Copy Password</button>

                @if (_selectedEntry is not null && !_isEditingEntry)
                {
                    <button class="panel-btn panel-btn-primary" type="button" @onclick="StartEditingSelectedEntry">Edit Entry</button>
                }
                else if (_selectedEntry is not null && _isEditingEntry)
                {
                    <button class="panel-btn panel-btn-primary" type="button" @onclick="UpdateSelectedEntryAsync">Update</button>
                }
            </footer>
        </section>
    </div>

}


@if (showAddEntryModal)
{
    <div class="modal-overlay" @onclick="CloseAddEntry">
        <section class="modal-panel modal-panel-wide" aria-labelledby="add-entry-title" aria-modal="true" role="dialog" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="CloseAddEntry">×</button>
            <header class="modal-header">
                <h2 id="add-entry-title" class="modal-title">Add Entry</h2>
                <p class="modal-subtitle">Store a new login with clear structure and tags.</p>
            </header>

            <div class="add-entry-layout">
                <form id="add-entry-form" class="add-entry-form" @onsubmit="HandleSaveEntryAsync" @onsubmit:preventDefault>
                    <div class="form-grid">
                        <label class="form-field">
                            <span>Entry name</span>
                            <input class="field-input" type="text" placeholder="e.g. GitHub" @bind="_entryName" />
                        </label>

                        <label class="form-field">
                            <span>Category</span>
                            <select class="field-input" @bind="_category">
                                <option>Work</option>
                                <option>Personal</option>
                                <option>Finance</option>
                                <option>Shopping</option>
                            </select>
                        </label>

                        <label class="form-field">
                            <span>Website / app URL</span>
                            <input class="field-input" type="url" placeholder="https://..." @bind="_url" />
                        </label>

                        <label class="form-field">
                            <span>Username / email</span>
                            <input class="field-input" type="text" placeholder="name@example.com" @bind="_username" />
                        </label>

                        <label class="form-field">
                            <span>Password</span>
                            <div class="password-row">
                                <input class="field-input" type="password" placeholder="••••••••••••" @bind="_password" />
                                <button class="panel-btn panel-btn-secondary" type="button">Generate</button>
                            </div>
                        </label>

                        <label class="form-field">
                            <span>Tags</span>
                            <input class="field-input" type="text" placeholder="team, primary, 2fa" @bind="_tags" />
                        </label>
                    </div>

                    <label class="form-field form-field-full">
                        <span>Notes</span>
                        <textarea class="field-input notes-input" rows="5" placeholder="Recovery hints, backup codes, or extra context..." @bind="_notes"></textarea>
                    </label>

                    @if (!string.IsNullOrWhiteSpace(_saveError))
                    {
                        <p class="master-password-error" role="alert">@_saveError</p>
                    }
                </form>

                <aside class="add-entry-side">
                    <h3>Quick Checklist</h3>
                    <p>Use unique passwords per account and save recovery details in Notes.</p>
                    <div class="tip-chips">
                        <span class="tip-chip">12+ chars</span>
                        <span class="tip-chip">Upper + lower</span>
                        <span class="tip-chip">Numbers + symbols</span>
                        <span class="tip-chip">Enable 2FA</span>
                    </div>
                </aside>
            </div>

            <footer class="modal-footer">
                <button class="panel-btn panel-btn-secondary" type="button" @onclick="CloseAddEntry">Cancel</button>
                <button class="panel-btn panel-btn-primary" type="submit" form="add-entry-form">Save Entry</button>
            </footer>
        </section>
    </div>
}


@code {
    private bool showAddEntryModal;
    private bool showViewEntryModal;
    private readonly List<VaultEntry> _entries = new();
    private VaultEntry? _selectedEntry;
    private void SelectEntry(VaultEntry entry) => _selectedEntry = entry;

    private string _entryName = string.Empty;
    private string _category = "Work";
    private string _url = string.Empty;
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _tags = string.Empty;
    private string _notes = string.Empty;
    private string? _saveError;
    
    // Editing fields
    private bool _isEditingEntry;
    private string _editEntryName = string.Empty;
    private string _editCategory = string.Empty;
    private string _editUrl = string.Empty;
    private string _editUsername = string.Empty;
    private string _editPassword = string.Empty;
    private string _editTags = string.Empty;
    private string _editNotes = string.Empty;

    private int EntryCount => _entries.Count;
    private int StrongPasswordCount => _entries.Count(entry => IsStrongPassword(entry.Password));
    private int DistinctCategories => _entries
        .Select(entry => entry.Category)
        .Where(category => !string.IsNullOrWhiteSpace(category))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    //Editing entry porting selected entry into draft fields.
    private void StartEditingSelectedEntry()
    {
        if (_selectedEntry is null) return;
        
        _editEntryName = _selectedEntry.EntryName;
        _editCategory = _selectedEntry.Category;
        _editUrl = _selectedEntry.Url;
        _editUsername = _selectedEntry.Username;
        _editPassword = _selectedEntry.Password;
        _editTags = string.Join(", ", _selectedEntry.Tags);
        _editNotes = _selectedEntry.Notes;
        _isEditingEntry = true;
    }

    private async Task UpdateSelectedEntryAsync()
    {
        if (_selectedEntry is null)
        {
            _saveError = "Select an entry first.";
            return;
        }

        await VaultFacade.UpdateEntryAsync(
            _selectedEntry.Id,
            _editEntryName,
            _editCategory,
            _editUrl,
            _editUsername,
            _editPassword,
            _editNotes,
            _editTags);

        await LoadEntriesAsync();
        _isEditingEntry = false;
    }
    
    
    
    // Runs once Dashboard is created, subscribes the dashboard to AppState.OnChange
    // so that way gets notified when the vault unlocks
    protected override void OnInitialized()
    {
        AppState.OnChange += HandleVaultStateChanged;
    }

    private async Task LoadEntriesAsync()
    {
        _entries.Clear();
        _entries.AddRange(await VaultFacade.GetEntriesAsync());
    }

    // Runs when AppState.SetUnlocked() fires. It reloads entries from VaultFacade.GetEntriesAsync() and redraws UI.
    private async void HandleVaultStateChanged()
    {
        await LoadEntriesAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Unsubcribes when the component is destroyed
    public void Dispose()
    {
        AppState.OnChange -= HandleVaultStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadEntriesAsync();
        }
        catch (UnauthorizedAccessException)
        {
            _saveError = "Unlock the vault before managing entries.";
        }
    }

    private void OpenAddEntry()
    {
        showViewEntryModal = false;
        showAddEntryModal = true;
    }

    private void CloseAddEntry() => showAddEntryModal = false;

    private async Task OpenViewEntry()
    {
        showAddEntryModal = false;
        showViewEntryModal = true;

        // Reload entries every time the view opens so unlocked data is shown immediately.
        await LoadEntriesAsync();
    }

    private void CloseViewEntry() => showViewEntryModal = false;

    
    // Start of the Entry flow - Calls AddEntryAsync in facade interface to save the entry and then refreshes the list of entries
    private async Task HandleSaveEntryAsync()
    {
        _saveError = null;

        try
        {
            await VaultFacade.AddEntryAsync(
                _entryName,
                _category,
                _url,
                _username,
                _password,
                _notes,
                _tags);

            await LoadEntriesAsync();

            ResetForm();
            CloseAddEntry();
        }
        catch (UnauthorizedAccessException ex)
        {
            _saveError = ex.Message;
        }
        catch (ArgumentException ex)
        {
            _saveError = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _saveError = ex.Message;
        }
    }

    // Resets the forms
    private void ResetForm()
    {
        _entryName = string.Empty;
        _category = "Work";
        _url = string.Empty;
        _username = string.Empty;
        _password = string.Empty;
        _tags = string.Empty;
        _notes = string.Empty;
    }

    private static bool IsStrongPassword(string password)
    {
        if (string.IsNullOrEmpty(password) || password.Length < 12)
        {
            return false;
        }

        bool hasUpper = password.Any(char.IsUpper);
        bool hasLower = password.Any(char.IsLower);
        bool hasDigit = password.Any(char.IsDigit);
        bool hasSymbol = password.Any(ch => !char.IsLetterOrDigit(ch));
        return hasUpper && hasLower && hasDigit && hasSymbol;
    }
}
