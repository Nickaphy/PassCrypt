@page "/dashboard"
@using Vault.Core
@using Vault.Core.Services
@using Vault.Facade.Interface
@inject IVaultFacade VaultFacade
@inject VaultAppState AppState

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-container">
    <section class="dashboard-card">
        <p class="dashboard-kicker">Vault Overview</p>
        <h1 class="dashboard-title">PassCrypt</h1>

        <div class="dashboard-metrics">
            <article class="metric-card">
                <span class="metric-value">@EntryCount</span>
                <span class="metric-label">Saved Entries</span>
            </article>
            <article class="metric-card">
                <span class="metric-value">@StrongPasswordCount</span>
                <span class="metric-label">Strong Passwords</span>
            </article>
            <article class="metric-card">
                <span class="metric-value">@DistinctCategories</span>
                <span class="metric-label">Categories</span>
            </article>
        </div>

        <div class="dashboard-actions">
            <button class="btn" @onclick="OpenAddEntry">Add Entry</button>
            <button class="btn" @onclick="OpenViewEntry">View Entries</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_saveError))
        {
            <p class="form-error" role="alert">@_saveError</p>
        }
    </section>
</div>


@if (showViewEntryModal)
{
    <ViewEntriesModal OnClose="CloseViewEntry" OnEntriesChanged="LoadEntriesAsync" />
}


@if (showAddEntryModal)
{
    <AddEntryModal OnClose="CloseAddEntry" OnSaved="HandleEntrySavedAsync" />
}


@code {
    private bool showAddEntryModal;
    private bool showViewEntryModal;
    private readonly List<VaultEntry> _entries = new();

    private string? _saveError;

    private int EntryCount => _entries.Count;
    private int StrongPasswordCount => _entries.Count(entry => PasswordStrengthEvaluator.IsStrong(entry.Password));
    private int DistinctCategories => _entries
        .Select(entry => entry.Category)
        .Where(category => !string.IsNullOrWhiteSpace(category))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    // Runs once Dashboard is created, subscribes the dashboard to AppState.OnChange
    // so that way gets notified when the vault unlocks
    protected override void OnInitialized()
    {
        AppState.OnChange += HandleVaultStateChanged;
    }

    private async Task LoadEntriesAsync()
    {
        _entries.Clear();
        _entries.AddRange(await VaultFacade.GetEntriesAsync());
    }

    // Runs when AppState.SetUnlocked() fires. It reloads entries from VaultFacade.GetEntriesAsync() and redraws UI.
    private async void HandleVaultStateChanged()
    {
        await LoadEntriesAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Unsubcribes when the component is destroyed
    public void Dispose()
    {
        AppState.OnChange -= HandleVaultStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadEntriesAsync();
        }
        catch (UnauthorizedAccessException)
        {
            _saveError = "Unlock the vault before managing entries.";
        }
    }

    private void OpenAddEntry()
    {
        showViewEntryModal = false;
        showAddEntryModal = true;
    }

    private void CloseAddEntry() => showAddEntryModal = false;

    private void OpenViewEntry()
    {
        showAddEntryModal = false;
        showViewEntryModal = true;
    }

    private void CloseViewEntry() => showViewEntryModal = false;

    // Raised by AddEntryModal after it has saved the entry itself.
    private async Task HandleEntrySavedAsync()
    {
        await LoadEntriesAsync();
        CloseAddEntry();
    }
}
